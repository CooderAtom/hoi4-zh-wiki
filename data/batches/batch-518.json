  },
  {
   "k": "1ys4hk6",
   "en": "Allows the player to choose between increased centralization or increased autonomy for Yugoslavia's constituent states, and also to choose between remaining non-aligned, joining the Allies or joining the Axis."
  },
  {
   "k": "1cm5er7",
   "en": "Recognize the Soviet Union branch"
