 "units": [
  {
   "k": "m26xq7",
   "en": "The ⟦0⟧ element is used to define a listbox, which is a scrollable list that is populated with entries. Typically these elements are internally linked with another container, which composes the actual entry used in the list box.",
   "frags": 1
  },
  {
   "k": "rogwbe",
   "en": "⟦0⟧ - The listbox name.",
   "frags": 1
  },
  {
   "k": "q2xduc",
   "en": "⟦0⟧ - The screen position of the listbox.",
   "frags": 1
  },
  {
   "k": "1szqfd2",
   "en": "⟦0⟧ - The bounding box for the listbox.",
   "frags": 1
  },
  {
   "k": "zwwqfa",
   "en": "⟦0⟧ - The spacing to use between listbox entries.",
   "frags": 1
  },
  {
   "k": "1jq03y6",
   "en": "spacing"
  },
  {
   "k": "lvreme",
   "en": "⟦0⟧ - Whether the listbox is horizontal (1) or vertical (0).",
   "frags": 1
  },
  {
   "k": "1rn5l3p",
   "en": "⟦0⟧ - The scrollbar to use for the listbox.",
   "frags": 1
  },
  {
   "k": "ujpt2p",
   "en": "scrollbartype"
  },
  {
   "k": "40bfuq",
   "en": "⟦0⟧ - The bounding box for the border for the listbox.",
   "frags": 1
  },
  {
   "k": "1lb1z66",
   "en": "bordersize"
  },
  {
   "k": "o1b07v",
   "en": "⟦0⟧ - Forces the listbox to allow click through, i.e. clicking on an element behind another element.",
   "frags": 1
  },
  {
   "k": "kzuxlp",
   "en": "background"
  },
  {
   "k": "3h6sqg",
   "en": "The ⟦0⟧ element is used to add checkboxes to the interface. The actual effect of the checkbox is defined internally.",
   "frags": 1
  },
  {
   "k": "1ugm8q",
   "en": "⟦0⟧ - The checkbox name.",
   "frags": 1
  },
  {
   "k": "1t48nqu",
   "en": "⟦0⟧ - The screen position of the checkbox.",
   "frags": 1
  },
  {
   "k": "1r9l75s",
   "en": "⟦0⟧ - The image to use for the checkbox. Refers to a ⟦1⟧ definition.",
   "frags": 2
  },
  {
   "k": "hyojzf",
   "en": "⟦0⟧ - The image to use for the checkbox. Refers to a dynamic ⟦1⟧ definitions (i.e. flags) or multi-frame ⟦2⟧ definitions.",
   "frags": 3
  },
  {
   "k": "ufftor",
   "en": "⟦0⟧ - Which frame to use for the checkbox when using a multi-frame image.",
   "frags": 1
  },
  {
   "k": "ydm29z",
   "en": "⟦0⟧ - Forces the checkbox to allow click through, i.e. clicking on an element behind another element.",
   "frags": 1
  },
  {
   "k": "1p2hkqz",
   "en": "⟦0⟧ - The text displayed by the checkbox.",
   "frags": 1
  },
  {
   "k": "1lraj48",
