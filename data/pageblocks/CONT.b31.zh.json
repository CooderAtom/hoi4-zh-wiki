 "items": [
  { "k": "wvhfpl", "zh": "加入了最大帧率限制系统（默认为 75fps），以帮助那些同时具备散热差、显卡好且屏幕刷新率极高的人。如果你正是这类有散热问题的人，我很想知道这是否解决了问题（在设置中修改 max_frame_rate 可以调高来移除其效果，或者如果你仍有问题可以调得更低）" },
  { "k": "91a45g", "zh": "范妮·雅布洛夫斯基（⟦0⟧）、林利思戈勋爵（⟦1⟧）、李宗仁（⟦2⟧）、曼努埃尔·路易斯·奎松（⟦3⟧）、阿尔芒·克林内斯库（⟦4⟧）、格奥尔基·塔塔雷斯库（⟦5⟧）、盛世才（⟦6⟧）、米兰·格罗尔（⟦7⟧）、米兰·斯托亚迪诺维奇（⟦8⟧）" },
  { "k": "15wzt40", "zh": "大型和平会议决议现在处理得更快，并且会正确地向非参与方表明它们处于生效状态。" },
  { "k": "16wyesc", "zh": "阻止了一种漏洞，即玩家可以在没有准备的情况下把海军运输改为登陆。" },
  { "k": "wk9ymm", "zh": "为分辨率极低或极高的显示器加入了 GUI 缩放选项（实验性）。" },
  { "k": "19zghjm", "zh": "修复了舰队发现自己超出基地航程时会被立即删除的情况。" },
  { "k": "skwqfx", "zh": "修复了在继续存档游戏时于西班牙内战期间部署部队的问题。" },
  { "k": "1x7qpoq", "zh": "法国现在如果选取「支持民族主义者」焦点，就可以向西班牙派遣志愿军。" },
  { "k": "emd1dm", "zh": "1.0.1 是一个热修复补丁，于 2016-06-13⟦0⟧发布，校验和为⟦1⟧。" },
